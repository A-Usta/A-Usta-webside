# Public client-side configuration only. Never put a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Required for TEST Android builds. This native Maps SDK key is separate from the backend Places API key.
# Keep the value in the local/EAS secret environment; never commit it.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional HTTPS A-USTA Render API host for an isolated TEST backend.
EXPO_PUBLIC_SERVICE_API_URL=https://YOUR-AUSTA-TEST.onrender.com
